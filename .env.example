# Copy to .env.local (and add the same values in Vercel → Settings → Environment Variables).
# Leave the Supabase values empty to run the site in preview mode (everything stays in the browser).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional branding (defaults shown)
NEXT_PUBLIC_BRAND_NAME=imaginati
NEXT_PUBLIC_BRAND_TAGLINE=where ideas take flight
NEXT_PUBLIC_COHORT_NAME=DSA Cohort
NEXT_PUBLIC_COHORT_DESCRIPTION=Live sessions, hand-picked LeetCode problems, and progress you can actually see.

# Optional: force preview mode even when Supabase is configured
NEXT_PUBLIC_DEMO_MODE=
